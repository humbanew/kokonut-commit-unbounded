{
  "name": "kambler-action",
  "description": "Kambler GitHub Action",
  "version": "0.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/humbanew/kambler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humbanew/kambler.git"
  },
  "bugs": {
    "url": "https://github.com/humbanew/kambler/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@ai-sdk/deepseek": "^1.0.20",
    "@ai-sdk/xai": "^2.0.23",
    "@anthropic-ai/sdk": "^0.65.0",
    "@azure/openai": "^2.0.0",
    "@discordjs/rest": "^2.6.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.11.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@mistralai/mistralai": "^1.10.0",
    "@notionhq/client": "^5.1.0",
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.10.0",
    "@whiskeysockets/baileys": "^6.7.20",
    "ai": "^5.0.60",
    "asana": "^3.1.2",
    "axios": "^1.12.2",
    "clickup.js": "^3.0.4",
    "cohere-ai": "^7.19.0",
    "discord-api-types": "^0.38.29",
    "discord-interactions": "^4.3.0",
    "discord.js": "^14.22.1",
    "figma-api": "^2.0.2-beta",
    "googleapis": "^161.0.0",
    "graphql-request": "^7.2.0",
    "langchain": "^0.3.35",
    "llamaindex": "^0.12.0",
    "monday-sdk-js": "^0.5.6",
    "node-telegram-bot-api": "^0.66.0",
    "node-trello": "^1.3.0",
    "octokit": "^5.0.3",
    "openai": "^6.1.0",
    "perplexity": "^1.0.1",
    "twilio": "^5.10.2",
    "zoomus": "^0.1.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@github/local-action": "^6.0.0",
    "@jest/globals": "^30.1.2",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.52.0",
    "ts-jest": "^29.4.4",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
