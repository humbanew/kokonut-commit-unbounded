{
    "name": "kokonut-commit-action",
    "description": "Kokonut Commit GitHub Action",
    "version": "1.0.0",
    "author": "humbanew",
    "type": "module",
    "private": false,
    "homepage": "https://github.com/humbanew/kambler",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/humbanew/kambler.git"
    },
    "bugs": {
        "url": "https://github.com/humbanew/kambler/issues"
    },
    "keywords": [
        "actions"
    ],
    "exports": {
        ".": "./dist/index.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "bundle": "npm run format:write && npm run package",
        "ci-test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
        "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
        "format:write": "npx prettier --write .",
        "format:check": "npx prettier --check .",
        "lint": "npx eslint .",
        "local-action": "npx @github/local-action . src/main.ts .env",
        "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
        "package:watch": "npm run package -- --watch",
        "test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
        "install-hook": "node scripts/install-hook.cjs",
        "build-cli": "npm run package",
        "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
    },
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@huggingface/inference": "^4.11.0",
        "octokit": "^5.0.3"
    },
    "devDependencies": {
        "@eslint/compat": "^1.3.2",
        "@github/local-action": "^6.0.0",
        "@jest/expect": "^29.7.0",
        "@jest/globals": "^29.7.0",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.5.2",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.32.1",
        "actionlint": "^2.0.6",
        "buffer-from": "^1.1.2",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.15.2",
        "eslint-plugin-prettier": "^5.5.5",
        "jest": "^29.7.0",
        "jest-circus": "^29.7.0",
        "make-coverage-badge": "^1.2.0",
        "prettier": "^3.8.3",
        "prettier-eslint": "^16.4.2",
        "rollup": "^4.60.4",
        "source-map": "^0.7.6",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.4.9",
        "ts-jest-resolver": "^2.0.1",
        "typescript": "^5.9.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "*"
    },
    "bin": {
        "kokonut-commit": "dist/cli.cjs"
    },
    "files": [
        "dist",
        "README.md",
        "scripts"
    ],
    "prepare": "npm run build-cli",
    "publishConfig": {
        "access": "public"
    }
}
